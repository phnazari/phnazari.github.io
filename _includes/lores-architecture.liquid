      <div class="lr-arch-detail">
        <h4>KV cache</h4>
        <svg viewBox="0 0 420 230" role="img" aria-labelledby="lr-arch-cache-title lr-arch-cache-desc">
          <title id="lr-arch-cache-title">KV cache: append</title>
          <desc id="lr-arch-cache-desc">Softmax attention reads the stored keys and values. A newly quantized key and value are appended at each step. Only this new entry is outlined as just quantized. Earlier entries are reused.</desc>
          <defs>
            <marker id="lr-arch-cache-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M1 1L7 4L1 7Z" class="lr-arch-arrowhead"/></marker>
            <pattern id="lr-arch-cache-hatch" width="6" height="6" patternUnits="userSpaceOnUse"><path d="M-1 1L1-1M0 6L6 0M5 7L7 5" class="lr-arch-state-hatch"/></pattern>
            <pattern id="lr-arch-cache-quant-hatch" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M-1 1L1-1M0 5L5 0M4 6L6 4" class="lr-arch-quant-hatch"/></pattern>
          </defs>
