        <svg viewBox="0 0 420 230" role="img" aria-labelledby="lr-arch-recurrent-title lr-arch-recurrent-desc">
          <title id="lr-arch-recurrent-title">Recurrent state: overwrite</title>
          <desc id="lr-arch-recurrent-desc">The recurrence takes the query, key, value, and previous state. It overwrites the entire state through a quantizer after each update. The outline marks the whole state as just quantized.</desc>
          <defs>
            <marker id="lr-arch-recurrent-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M1 1L7 4L1 7Z" class="lr-arch-arrowhead"/></marker>
