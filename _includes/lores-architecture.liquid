          <rect x="190" y="61" width="13" height="26" rx="4" fill="url(#lr-arch-recurrent-quant-hatch)" aria-hidden="true"/>
          <text x="90" y="165" text-anchor="middle">recurrence</text>
          <text x="295" y="59" text-anchor="middle" class="lr-arch-action">overwrite</text>
          <text x="315" y="165" text-anchor="middle" class="lr-arch-math">S<tspan class="lr-arch-sub">t−1</tspan><tspan class="lr-arch-map"> → </tspan>S<tspan class="lr-arch-sub">t</tspan></text>
          <g class="lr-arch-math lr-arch-operands">
